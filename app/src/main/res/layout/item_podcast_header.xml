<?xml version="1.0" encoding="utf-8"?>
<!-- The podcast screen's header, on the page above the episode group. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="8dp"
    android:paddingBottom="24dp">

    <ImageView
        android:id="@+id/header_art"
        android:layout_width="128dp"
        android:layout_height="128dp"
        android:background="@drawable/bg_art_placeholder"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/header_author"
        style="@style/Onecast.Text.ListSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center" />

    <TextView
        android:id="@+id/header_description"
        style="@style/Onecast.Text.Body.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:ellipsize="end"
        android:maxLines="5" />
</LinearLayout>
