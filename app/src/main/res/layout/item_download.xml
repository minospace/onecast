<?xml version="1.0" encoding="utf-8"?>
<!-- A finished download inside the Downloads screen's "downloaded" group. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Onecast.Row.TrailingButton"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/download_art"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_art_placeholder"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/download_title"
            style="@style/Onecast.Text.ListTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2" />

        <TextView
            android:id="@+id/download_subtitle"
            style="@style/Onecast.Text.ListSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:singleLine="true" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/download_delete"
        style="@style/Onecast.IconButton"
        android:contentDescription="@string/downloads_delete"
        android:src="@drawable/ic_delete" />
</LinearLayout>
