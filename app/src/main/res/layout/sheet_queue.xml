<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sheet_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:alpha="0.6"
            android:background="@drawable/grabber" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp">

        <TextView
            style="@style/Onecast.Text.Headline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/queue_title" />

        <TextView
            android:id="@+id/queue_clear"
            style="@style/Onecast.Button.Text"
            android:layout_width="wrap_content"
            android:text="@string/queue_clear_short" />
    </LinearLayout>

    <be.miro.onecast.ui.MaxHeightRecyclerView
        android:id="@+id/queue_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:maxHeight="@dimen/sheet_list_max_height"
        android:paddingBottom="24dp"
        android:scrollbars="none" />

    <LinearLayout
        android:id="@+id/empty_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        android:paddingTop="24dp"
        android:paddingBottom="40dp"
        android:visibility="gone">

        <TextView
            style="@style/Onecast.Text.Headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/queue_empty" />

        <TextView
            style="@style/Onecast.Text.Body.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/queue_empty_hint" />
    </LinearLayout>
</LinearLayout>
