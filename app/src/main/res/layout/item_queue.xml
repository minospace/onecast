<?xml version="1.0" encoding="utf-8"?>
<!-- An Up Next row. The sheet is itself the surface, so these rows sit on it ungrouped and run edge to edge. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Onecast.Row.TrailingButton"
    android:layout_marginStart="0dp"
    android:layout_marginEnd="0dp"
    android:background="?attr/selectableItemBackground"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/queue_art"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_art_placeholder"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/queue_title"
            style="@style/Onecast.Text.ListTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2" />

        <TextView
            android:id="@+id/queue_subtitle"
            style="@style/Onecast.Text.ListSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:singleLine="true" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/queue_remove"
        style="@style/Onecast.IconButton"
        android:contentDescription="@string/queue_remove_item"
        android:src="@drawable/ic_close" />
</LinearLayout>
