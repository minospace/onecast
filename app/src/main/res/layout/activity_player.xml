<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_content_background">

    <!-- Artwork-derived gradient wash, drawn full-bleed behind the content. -->
    <View
        android:id="@+id/player_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

<!-- The player's vertical drags are taken here, anywhere on it, rather than by any one child
     (see PlayerSheet) — hence the intercepting layout. -->
<be.miro.onecast.ui.player.DragInterceptLayout
    android:id="@+id/player_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingBottom="24dp">

    <!-- Artwork and grabber. Also the measuring stick for how far the player slides up to make
         room for the episode notes, so it stays one view even though it no longer owns a gesture. -->
    <LinearLayout
        android:id="@+id/player_drag_zone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <View
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:alpha="0.6"
                android:background="@drawable/grabber" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/player_art"
                android:layout_width="300dp"
                android:layout_height="300dp"
                android:background="@drawable/bg_art_placeholder"
                android:contentDescription="@null"
                android:elevation="8dp"
                android:scaleType="centerCrop"
                android:transitionName="player_art" />

            <!-- Takes the artwork's place while the user is watching (see PlayerActivity). -->
            <be.miro.onecast.ui.player.VideoFrameLayout
                android:id="@+id/player_video_frame"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/black"
                android:elevation="8dp"
                android:visibility="gone"
                tools:visibility="visible">

                <TextureView
                    android:id="@+id/player_video"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <ProgressBar
                    android:id="@+id/player_video_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="gone" />
            </be.miro.onecast.ui.player.VideoFrameLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/player_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:ellipsize="end"
        android:gravity="center"
        android:lineSpacingMultiplier="1.05"
        android:maxLines="2"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/player_podcast"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:gravity="center"
        android:singleLine="true"
        style="@style/Onecast.Text.ListSummary" />

    <!-- Scrolls sideways: a long chapter title next to the video and Up Next chips can outgrow a
         narrow screen. fillViewport keeps the row centred while it still fits. -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fillViewport="true"
        android:scrollbars="none">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/player_chapter"
            style="@style/Onecast.Chip"
            android:layout_width="wrap_content"
            android:layout_marginEnd="8dp"
            android:drawableStart="@drawable/ic_chapters"
            android:ellipsize="end"
            android:maxWidth="200dp"
            android:visibility="gone"
            tools:text="1. Introduction"
            tools:visibility="visible" />

        <Button
            android:id="@+id/player_video_toggle"
            style="@style/Onecast.Chip"
            android:layout_width="wrap_content"
            android:layout_marginEnd="8dp"
            android:drawableStart="@drawable/ic_video"
            android:text="@string/video_show"
            android:visibility="gone"
            tools:visibility="visible" />

        <Button
            android:id="@+id/player_up_next"
            style="@style/Onecast.Chip"
            android:layout_width="wrap_content"
            android:drawableStart="@drawable/ic_queue"
            android:text="@string/action_queue" />
    </LinearLayout>
    </HorizontalScrollView>

    <SeekBar
        android:id="@+id/player_seekbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/player_position"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="@style/Onecast.Text.Caption"
            android:text="0:00" />

        <TextView
            android:id="@+id/player_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Onecast.Text.Caption"
            android:text="0:00" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/player_skip_back"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_round_gray"
            android:contentDescription="@string/widget_skip_back"
            android:src="@drawable/ic_skip_back"
            android:tint="?android:attr/textColorPrimary" />

        <ImageButton
            android:id="@+id/player_play_pause"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginHorizontal="28dp"
            android:background="@drawable/bg_round_gray"
            android:contentDescription="@string/widget_play_pause"
            android:padding="20dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_play_rounded"
            android:tint="?android:attr/textColorPrimary" />

        <ImageButton
            android:id="@+id/player_skip_forward"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_round_gray"
            android:contentDescription="@string/widget_skip_forward"
            android:src="@drawable/ic_skip_forward"
            android:tint="?android:attr/textColorPrimary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/player_speed"
            style="@style/Onecast.Button.Tonal"
            android:layout_width="wrap_content"
            android:minWidth="88dp"
            android:text="1.0×" />

        <Button
            android:id="@+id/player_mark_played"
            style="@style/Onecast.Button.Tonal"
            android:layout_width="wrap_content"
            android:layout_marginStart="12dp"
            android:drawableStart="@drawable/ic_check"
            android:drawablePadding="8dp"
            android:text="@string/mark_played" />
    </LinearLayout>
</be.miro.onecast.ui.player.DragInterceptLayout>

    <!--
        Episode notes, parked just off the bottom edge. Scrolling up on the player slides the
        player content up by exactly the artwork's height and brings this into the space it
        vacates (see PlayerSheet); its height is set from that same measurement.
        INVISIBLE, not alpha 0, so it doesn't swallow taps meant for the controls underneath.
    -->
    <LinearLayout
        android:id="@+id/player_info"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:visibility="invisible"
        tools:visibility="visible">

        <TextView
            android:id="@+id/player_info_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="24dp"
            android:paddingBottom="10dp"
            style="@style/Onecast.Text.Headline"
            android:text="@string/episode_notes" />

        <ScrollView
            android:id="@+id/player_info_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingHorizontal="24dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/player_info_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Onecast.Text.Caption"
                    android:layout_marginBottom="8dp"
                    tools:text="3 days ago · 52 min" />

                <TextView
                    android:id="@+id/player_info_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Onecast.Text.Body.Secondary"
                    android:textColorLink="?attr/appPrimaryText"
                    tools:text="@string/episode_notes_empty" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
