<?xml version="1.0" encoding="utf-8"?>
<!-- A search result inside the results group: artwork, title, author, and an add icon. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Onecast.Row"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/result_art"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_art_placeholder"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/result_title"
            style="@style/Onecast.Text.ListTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2" />

        <TextView
            android:id="@+id/result_author"
            style="@style/Onecast.Text.ListSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:singleLine="true" />
    </LinearLayout>

    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_add"
        android:tint="?attr/appPrimaryText" />
</LinearLayout>
