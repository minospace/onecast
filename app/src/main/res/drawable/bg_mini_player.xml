<?xml version="1.0" encoding="utf-8"?>
<!-- Mini-player: a floating surface-raised card on the widget radius (radius-md). No border — it
     floats on its shadow, like the design system's other floating elements. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/app_surface_raised" />
    <corners android:radius="@dimen/radius_md" />
</shape>
