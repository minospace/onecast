<resources>
    <!-- ── One UI 9 Style design-system tokens ─────────────────────────────────────────────────
         Light values here, dark ones in values-night/. Every screen is a grey page (`bg`) with
         content grouped on rounded white `surface` cards; in dark mode the page is pure black and
         the groups are near-black. Names mirror the design system's tokens (app_<token>). -->

    <!-- bg: the page behind everything. SESL reads its window/toolbar colour from these library
         resources (oui_background_color → sesl_background_color_*), so overriding them here puts the
         whole ToolbarLayout — app bar, content area, window and system bars — on the design-system
         page colour without any per-view recolouring. Both suffixes live in this default folder
         because the library declares them that way (the theme picks _light or _dark). -->
    <color name="sesl_background_color_light">#FFF2F2F2</color>
    <color name="sesl_background_color_dark">#FF000000</color>
    <!-- The page colour, reachable through the app R class. Resolves day/night via the library's
         own oui_background_color, which now points at the values above. -->
    <color name="app_content_background">@color/oui_background_color</color>
    <!-- oneui-design's ToolbarLayout paints its app-bar header and the content area's rounded
         corners straight from these resources (a theme attribute has no effect), so point them at
         the page colour too: the app bar, the content and the window are one continuous page. -->
    <color name="sesl_round_and_bgcolor_light">@color/oui_background_color</color>
    <color name="sesl_round_and_bgcolor_dark">@color/oui_background_color</color>
    <color name="sesl_action_bar_background_color_light">@color/oui_background_color</color>
    <color name="sesl_action_bar_background_color_dark">@color/oui_background_color</color>

    <!-- Text. Overriding SESL's own resources moves every widget (preferences, dialogs, menus) onto
         the design-system values, which hold 4.5:1 on bg, surface, surface-raised and
         surface-container in both themes (SESL's #8C8C8C secondary grey didn't). -->
    <color name="sesl_primary_text_color_light">#FF111111</color>
    <color name="sesl_primary_text_color_dark">#FFF5F5F5</color>
    <color name="sesl_secondary_text_color_light">#FF636366</color>
    <color name="sesl_secondary_text_color_dark">#FFA3A3A3</color>

    <!-- primary: the blue fill of switch tracks, checked boxes, slider fills and filled buttons.
         SESL reads it from these resources as well as from the theme, so both move together. -->
    <color name="sesl_primary_color_light">#FF1D5FE5</color>
    <color name="sesl_primary_color_dark">#FF2A6AF0</color>
    <color name="sesl_primary_dark_color_light">#FF1D5FE5</color>
    <color name="sesl_primary_dark_color_dark">#FF2A6AF0</color>
    <color name="app_primary">#FF1D5FE5</color>
    <color name="app_on_primary">#FFFFFFFF</color>
    <!-- primary-text: blue *text* (links, text buttons, live values, the playing episode). Same as
         primary in light mode; lighter in dark mode, where the fill blue is too dark to read. Reach
         it through ?attr/appPrimaryText so the Material You option can move it. -->
    <color name="app_primary_text">#FF1D5FE5</color>

    <!-- Material 3 Expressive accent, used in place of app_primary / app_primary_text when the user
         turns on "Material You colours" in Settings (see ui/ExpressiveTheme). Everything
         accent-coloured reaches this through ?attr/colorPrimary or ?attr/appPrimaryText, which the
         overlay re-points here; nothing should reference app_primary directly, or it would stay blue
         while the rest of the app moved.

         This default is the M3 baseline primary (tone 40), the fallback for Android 11 and older
         where there is no wallpaper-derived palette. On API 31+ the values-v31/ + values-night-v31/
         variants re-point it at the system tonal palette, the same source the widget already uses. -->
    <color name="app_primary_expressive">#FF6750A4</color>

    <!-- surface: list groups and cards, on the page. Pure-black mode paints these black instead
         (ui/AmoledTheme.surface). -->
    <color name="app_surface">#FFFFFFFF</color>
    <!-- surface-raised: anything floating above the page — sheets, the mini-player. -->
    <color name="app_surface_raised">#FFFFFFFF</color>
    <!-- surface-container: search field, tonal buttons, chips, artwork placeholders. -->
    <color name="app_surface_container">#FFE9E9EB</color>
    <!-- Inset hairlines between rows of a group; also progress tracks. -->
    <color name="app_divider">#FFE3E3E5</color>
    <!-- Control outlines and the sheet/player grabber (≥3:1 on every surface). -->
    <color name="app_outline">#FF78787C</color>
    <!-- Destructive actions (Delete, Remove, Unsubscribe) — always paired with the word. -->
    <color name="app_danger">#FFC8243A</color>

    <color name="app_art_placeholder">@color/app_surface_container</color>

    <!-- Home-screen widget palette. A widget is inflated in the *launcher's* process against the
         launcher's theme, so ?android:attr/textColorPrimary and friends resolve to whatever that
         theme happens to be (often invisible against our own card) — the old widget's washed-out /
         unreadable text. These are concrete, day/night-qualified colours so the widget controls its
         own contrast regardless of the host launcher.

         These (values/ + values-night/) are the pre-Android-12 fallback. On API 31+ the same names
         are re-pointed at the wallpaper-derived Material You tonal palettes in values-v31/ +
         values-night-v31/, so the widget tints itself like Google's own widgets do. The widget goes
         dynamic unconditionally (a launcher-hosted widget can't read the app's theme or settings at
         inflate time), while the *app* is One UI blue unless the user opts in to Material You
         colours in Settings — which is why the widget has its own colour names and its own copies of
         the shared drawables (bg_widget_art, widget_progress, bg_widget_control) rather than sharing
         bg_art_placeholder / mini_progress / bg_round_gray. -->
    <color name="widget_surface">#FFFFFFFF</color>
    <color name="widget_surface_stroke">#33808080</color>
    <color name="widget_text_primary">#FF1A1A1A</color>
    <color name="widget_text_secondary">#8A000000</color>
    <!-- Round container shared by all three transport controls — the widget's copy of the player's
         bg_round_gray, which uses app_surface_container. -->
    <color name="widget_control_container">#14808080</color>
    <color name="widget_control">#FF1A1A1A</color>
    <!-- Progress fill only; the transport controls are neutral, matching the player. -->
    <color name="widget_accent">@color/app_primary</color>
    <color name="widget_progress_track">#33808080</color>
    <color name="widget_art_placeholder">#22808080</color>
    <color name="widget_icon_muted">#61000000</color>
    <!-- Press feedback for the widget's controls. Not dynamic (and not a ?attr/colorControlHighlight
         reference like bg_round_gray uses, which would resolve against the launcher's theme) —
         just a neutral scrim that works over either an accent-tinted or a plain surface. -->
    <color name="widget_ripple">#1F000000</color>
</resources>
